def menu(t, ask, say, options, default=1):
    for i, label in enumerate(options, 1):
        say(f"  {i}) {label}")
    while True:
        answer = ask(t["choose"].format(default=default)).strip()
        if not answer:
            return default
        if answer.isdigit() and 1 <= int(answer) <= len(options):
            return int(answer)


def wizard(ask=input, say=print):
    lang = "tr" if (os.environ.get("LANG") or "").startswith("tr") else "en"
    t = TEXT[lang]
    yes = ("e", "evet", "y", "yes") if lang == "tr" else ("y", "yes")
    say(t["title"] + "\n")
    c = gc.checks()
    missing = [n for n, ok in (("rclone >= 1.66", c["rcloneOk"]), ("systemd", c["systemd"])) if not ok]
    if missing:
        say(t["missing"] + " " + ", ".join(missing))
        if c["installCommand"]:
            say(t["install"].format(cmd=c["installCommand"]))
        return 1
    if not c["inotify"]:
        say(t["no_inotify"] + (f"\n  {c['installCommand']}" if c["installCommand"] else "") + "\n")
    current = gc.effective()
    if current and ask(t["already"].format(target=current["target"], local=current["local"],
                                           mode=current["mode"])).strip().lower() not in yes:
        return 0

    # account
    r = step_remotes()
    say(t["account"])
    names = [x["name"] for x in r["remotes"]]
    pick = menu(t, ask, say, names + [t["new_account"]])
    created = False
    if pick > len(names):
        remote = r["suggestName"]
        say(t["login"])
        exe = os.environ.get("GDRIVE_RCLONE") or "rclone"
        if subprocess.run([exe, "config", "create", remote.rstrip(":"), "drive", "scope=drive"]).returncode != 0:
            rclone(["config", "delete", remote.rstrip(":")], timeout=30)
            say(t["login_failed"])
            return 1
        created = True
    else:
        remote = names[pick - 1]

    # Drive folder
    say("\n" + t["drive"])
    remote_path = ""
    if menu(t, ask, say, [t["whole"], t["pick"]]) == 2:
        while True:
            folders = step_drive_folders(remote, remote_path)["folders"]
            say(t["in_folder"].format(path=target_of(remote, remote_path)))
            options = [t["use_this"]] + ([t["up"]] if remote_path else []) + folders
            n = menu(t, ask, say, options)
            if n == 1:
                break
            if remote_path and n == 2:
                remote_path = remote_path.rpartition("/")[0]
                continue
            remote_path = "/".join(x for x in (remote_path, options[n - 1]) if x)

    # local folder, mode, first sync
    modes = list(gc.MODES)
    default_local = os.path.join(gc.paths()["home"], "GoogleDrive")
    while True:
        say("")
        local = ask(t["local"].format(default=default_local)).strip() or default_local
        chk = step_check_local(local)
        if not chk["ok"]:
            say(t["refused"][chk["reason"]])
            continue
        local = chk["path"]
        say("\n" + t["mode"])
        mode = modes[menu(t, ask, say, t["modes"]) - 1]
        first = "none"
        if mode == "twoway":
            if chk["empty"]:
                first = "empty"
            elif chk["ours"]:
                first = "resume"
            else:
                say(t["checking"])
                pv = step_preview(remote, remote_path, local)
                say(t["preview"].format(**pv))
                first = "merge"
                if pv["needsChoice"]:
                    say(t["choice"])
                    aside = os.path.join(gc.paths()["share"], "set-aside-" + datetime.date.today().isoformat())
                    n = menu(t, ask, say, [x.format(aside=aside) for x in t["choices"]])
                    if n == 1:
                        default_local = os.path.join(gc.paths()["home"], "GoogleDrive2") \
                            if local == default_local else default_local
                        continue
                    first = "match" if n == 2 else "merge"
        break

    mode_label = t["modes"][modes.index(mode)].split(" (")[0]
    if ask(t["summary"].format(target=target_of(remote, remote_path), local=local,
                               mode=mode_label)).strip().lower() not in yes + ("",):
        return 0
    save_setup({"step": "apply", "state": "running", "unit": None, "pid": os.getpid(),
                "startedAt": now_iso(), "error": None,
                "target": {"remote": remote, "remotePath": remote_path, "local": local, "mode": mode,
                           "firstSync": first, "createdRemote": created}})
    say(t["running"].format(log=os.path.join(gc.paths()["state"], "sync.log")))
    try:
        rc = step_apply_run(remote, remote_path, local, mode, first)
    except KeyboardInterrupt:
        update_setup(state="cancelled", finishedAt=now_iso())
        say("\n" + t["cancelled"])
        return 130
    if rc != 0:
        say(t["failed"].format(message=((load_setup() or {}).get("error") or {}).get("message", "")))
        return 1
    say(t["done"])
    return 0


# ---------- command line ----------

def run_step(name, args, flags):
    if name == "check":
        return step_check()
    if name == "remotes":
        return step_remotes()
    if name == "drive-folders" and 1 <= len(args) <= 2:
        return step_drive_folders(*args)
    if name == "check-local" and len(args) == 1:
        return step_check_local(args[0])
    if name == "preview" and len(args) == 3:
        return step_preview(*args)
    if name == "migrate":
        return step_migrate()
    if name == "connect" and len(args) == 1:
        return step_connect(args[0])
    if name == "apply" and len(args) == 5:
        return step_apply(*args)
    if name == "cancel":
        return step_cancel()
    if name == "disconnect":
        return step_disconnect(delete_remote="--delete-remote" in flags)
    if name == "install-service":
        return install_service(dev="--dev" in flags or os.environ.get("GDRIVE_DEV") == "1",
                               start="--start" in flags)
    return None


def main(argv):
    flags = {a for a in argv[1:] if a.startswith("--")}
    args = [a for a in argv[1:] if not a.startswith("--")]
    if not args and sys.stdin.isatty() and sys.stdout.isatty():
        return wizard()
    if not args:
        print(__doc__, file=sys.stderr)
        return 2
    if args[0] == "wizard":
        return wizard()
    if args[0] == "connect-run" and len(args) == 2:
        return step_connect_run(args[1])
    if args[0] == "apply-run" and len(args) == 6:
        return step_apply_run(*args[1:])
    try:
        result = run_step(args[0], args[1:], flags)
    except StepError as e:
        result = {"ok": False, "error": e.code, "message": e.message}
    if result is None:
        print(__doc__, file=sys.stderr)
        return 2
    if "--json" in flags:
        print(json.dumps(result, ensure_ascii=False))
    else:
        print(json.dumps(result, ensure_ascii=False, indent=1))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
