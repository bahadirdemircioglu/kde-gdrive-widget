#!/usr/bin/env python3
"""gdrive-setup: first-run setup for the gdrive-sync service (terminal wizard and widget backend).

  gdrive-setup                      interactive wizard (in a terminal; also: gdrive-setup wizard)
  gdrive-setup <step> ... --json    one step, JSON on stdout (used by the Plasma widget)

Steps:
  check                             requirements (rclone >= 1.66, systemd, inotify-tools)
  remotes                           Google Drive connections already in rclone
  drive-folders REMOTE [PATH]       sub-folders of a Drive folder
  check-local PATH                  can this local folder be used?
  preview REMOTE PATH LOCAL         what is only on Drive / only here / different
  connect NAME                      new Google login (detached; progress in setup.json)
  apply REMOTE PATH LOCAL MODE FIRST
                                    first sync + config + service (detached)
  cancel                            stop a running connect/apply
  disconnect [--delete-remote]      stop the service, keep files, back up the config
  install-service [--dev] [--start] install scripts, commands and the systemd unit
  migrate                           write the config for a 0.1.0 install (no sync)

Standard library only. Binaries can be replaced for tests with GDRIVE_RCLONE,
GDRIVE_SYSTEMCTL and GDRIVE_SYSTEMD_RUN.
"""
import datetime
import json
import os
import re
import shutil
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
import gdrive_common as gc  # noqa: E402

SCRIPTS = ["gdrive-setup", "gdrive-sync", "gdrive-syncd", "gdrive-status", "gdrive-nfc",
           "gdrive_common.py", "gdrive-lib.sh"]
COMMANDS = ["gdrive-status", "gdrive-sync", "gdrive-setup", "gdrive-nfc"]
EXECUTABLE = ["gdrive-setup", "gdrive-sync", "gdrive-syncd", "gdrive-status", "gdrive-nfc"]


class StepError(Exception):
    def __init__(self, code, message=""):
        super().__init__(message or code)
        self.code = code
        self.message = message or code


# ---------- helpers ----------

def rclone(args, timeout=120, **kw):
    exe = os.environ.get("GDRIVE_RCLONE") or "rclone"
    try:
        return subprocess.run([exe, *args], capture_output=True, text=True, timeout=timeout, **kw)
    except FileNotFoundError:
        raise StepError("rclone_missing", "rclone is not installed")
    except subprocess.TimeoutExpired:
        raise StepError("timeout", "rclone did not answer")


def systemctl(*args):
    exe = os.environ.get("GDRIVE_SYSTEMCTL") or "systemctl"
    try:
        return subprocess.run([exe, "--user", *args], capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise StepError("systemd", str(e))


def rclone_error(p):
    text = (p.stderr or "") + (p.stdout or "")
    if "invalid_grant" in text or "oauth2" in text:
        return StepError("auth", "the Google login has expired")
    if "didn't find section in config file" in text or "not found in config" in text:
        return StepError("no_remote", "this connection does not exist")
    if "no such host" in text or "dial tcp" in text or "network is unreachable" in text:
        return StepError("offline", "Google Drive could not be reached")
    lines = [l for l in text.strip().splitlines() if l.strip()]
    return StepError("rclone", lines[-1] if lines else "rclone failed")


def norm_path(path):
    return os.path.normpath(os.path.abspath(os.path.expanduser(path)))


def inside(path, parent):
    """path is parent or below it."""
    return path == parent or path.startswith(parent.rstrip("/") + "/")


def target_of(remote, remote_path):
    return remote + remote_path.strip("/")


def load_setup():
    try:
        with open(gc.paths()["setupJson"], encoding="utf-8") as f:
            data = json.load(f)
        return data if isinstance(data, dict) else None
    except (OSError, ValueError):
        return None


def save_setup(data):
    gc.atomic_write(gc.paths()["setupJson"], json.dumps(data, ensure_ascii=False, indent=1))


def update_setup(**changes):
    data = load_setup() or {}
    data.update(changes)
    save_setup(data)
    return data


def now_iso():
    return datetime.datetime.now().astimezone().isoformat(timespec="seconds")


REMOTE_NAME_RE = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9_.-]*:?$")
FORWARD_ENV = ["PATH", "DISPLAY", "WAYLAND_DISPLAY", "DBUS_SESSION_BUS_ADDRESS", "XDG_RUNTIME_DIR",
               "XDG_CONFIG_HOME", "XDG_CURRENT_DESKTOP", "BROWSER", "LANG", "LANGUAGE"]


def start_detached(step, args):
    """Runs 'gdrive-setup <step>-run ...' as a transient user unit: it survives a Plasma
    restart and the widget does not have to wait for it."""
    unit = f"gdrive-setup-{step}"
    systemctl("stop", f"{unit}.service")
    systemctl("reset-failed", f"{unit}.service")
    exe = os.environ.get("GDRIVE_SYSTEMD_RUN") or "systemd-run"
    env = [f"--setenv={k}={v}" for k, v in os.environ.items()
           if (k in FORWARD_ENV or k.startswith("GDRIVE_") or k.startswith("RCLONE_")) and "\n" not in v]
    cmd = [exe, "--user", f"--unit={unit}", "--collect", "--quiet", *env,
           sys.executable or "python3", os.path.join(HERE, "gdrive-setup"), f"{step}-run", *args]
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise StepError("systemd", str(e))
    if p.returncode != 0:
        raise StepError("systemd", (p.stderr or "").strip() or "systemd-run failed")
    return f"{unit}.service"


def fail_setup(code, message):
    update_setup(state="failed", error={"code": code, "message": message}, finishedAt=now_iso())


# ---------- short steps ----------

def step_check():
    return gc.checks()


def step_remotes():
    p = rclone(["listremotes", "--long"], timeout=30)
    remotes, names = [], set()
    for line in p.stdout.splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[0].endswith(":"):
            names.add(parts[0])
            if parts[1] == "drive":
                remotes.append({"name": parts[0]})
    suggest = "gdrive:"
    n = 1
    while suggest in names:
        suggest = f"gdrive-sync-{n}:"
        n += 1
    return {"remotes": remotes, "suggestName": suggest}


def step_drive_folders(remote, path=""):
    p = rclone(["lsf", target_of(remote, path), "--dirs-only", "--max-depth", "1"], timeout=60)
    if p.returncode != 0:
        raise rclone_error(p)
    folders = [l.rstrip("/") for l in p.stdout.splitlines() if l.strip()]
    return {"folders": sorted(folders, key=str.casefold)}


def writable(path):
    """The folder, or the nearest existing folder above it, can be written to."""
    while not os.path.exists(path):
        parent = os.path.dirname(path)
        if parent == path:
            return False
        path = parent
    return os.path.isdir(path) and os.access(path, os.W_OK | os.X_OK)


def step_check_local(path):
    path = norm_path(path)
    p = gc.paths()
    home = norm_path(p["home"])
    current = gc.effective()
    reason = None
    if path == "/":
        reason = "root"
    elif inside(home, path):
        reason = "home"
    elif os.path.exists(path) and not os.path.isdir(path):
        reason = "file"
    elif any(inside(path, norm_path(d)) or inside(norm_path(d), path) for d in (p["state"], p["share"])):
        reason = "state"
    elif not writable(path):
        reason = "not_writable"
    elif current and path != norm_path(current["local"]) and (
            inside(path, norm_path(current["local"])) or inside(norm_path(current["local"]), path)):
        reason = "nested"
    exists = os.path.isdir(path)
    empty = not exists or not os.listdir(path)
    setup = load_setup() or {}
    ours_paths = {norm_path(x) for x in [((setup.get("target") or {}).get("local")),
                                         current and current["local"]] if x}
    return {"ok": reason is None, "reason": reason, "path": path, "exists": exists,
            "empty": empty, "ours": path in ours_paths}


def step_preview(remote, remote_path, local):
    local = norm_path(local)
    counts = {"same": 0, "onlyDrive": 0, "onlyLocal": 0, "different": 0}
    if not os.path.isdir(local) or not os.listdir(local):
        return dict(counts, empty=True, needsChoice=False)
    args = ["check", target_of(remote, remote_path), local, "--combined", "-",
            "--drive-skip-gdocs", "--checkers", "16"]
    filters = gc.paths()["filters"]
    if os.path.exists(filters):
        args += ["--filter-from", filters]  # (--filters-file exists only for bisync)
    p = rclone(args, timeout=3600)
    # rclone check SRC DST --combined: "+" only in SRC (Drive), "-" only in DST (here)
    keys = {"=": "same", "+": "onlyDrive", "-": "onlyLocal", "*": "different"}
    for line in p.stdout.splitlines():
        key = keys.get(line[:2].strip()) if line[1:2] == " " else None
        if key:
            counts[key] += 1
    if p.returncode not in (0, 1) or (p.returncode == 1 and not any(counts.values())):
        raise rclone_error(p)
    ours = step_check_local(local)["ours"]
    return dict(counts, empty=False,
                needsChoice=not ours and (counts["onlyLocal"] + counts["different"]) > 0)


def step_migrate():
    return {"migrated": gc.migrate_if_legacy()}


# ---------- Google login (detached) ----------

def remote_names():
    p = rclone(["listremotes", "--long"], timeout=30)
    out = {}
    for line in p.stdout.splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[0].endswith(":"):
            out[parts[0]] = parts[1]
    return out


def step_connect(name):
    if not REMOTE_NAME_RE.match(name):
        raise StepError("bad_name", "use letters, digits, - _ .")
    name = name.rstrip(":") + ":"
    if name in remote_names():
        raise StepError("name_taken", f"{name} already exists")
    save_setup({"step": "connect", "state": "running", "unit": "gdrive-setup-connect.service",
                "startedAt": now_iso(), "remote": name, "authUrl": None, "createdRemote": False,
                "error": None})
    start_detached("connect", [name])
    return {"started": True}


AUTH_URL_RE = re.compile(r"(http://127\.0\.0\.1:\d+/auth\?\S+)")


def step_connect_run(name):
    exe = os.environ.get("GDRIVE_RCLONE") or "rclone"
    bare = name.rstrip(":")
    try:
        proc = subprocess.Popen([exe, "config", "create", bare, "drive", "scope=drive"],
                                stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    except OSError as e:
        fail_setup("rclone_missing", str(e))
        return 1
    tail = []
    for line in proc.stdout:
        m = AUTH_URL_RE.search(line)
        if m:
            update_setup(authUrl=m.group(1))
        tail = (tail + [line.strip()])[-5:]
    rc = proc.wait()
    if rc != 0:
        rclone(["config", "delete", bare], timeout=30)  # no half-made connection left behind
        fail_setup("auth", " ".join(l for l in tail if l) or "login failed")
        return 1
    update_setup(state="done", createdRemote=True, finishedAt=now_iso(), error=None)
    return 0


# ---------- first sync + service (detached) ----------

FIRST_SYNC = ("empty", "match", "merge", "resume", "none")


def validate_apply(remote, remote_path, local, mode, first):
    if mode not in gc.MODES:
        raise StepError("bad_mode", mode)
    if first not in FIRST_SYNC:
        raise StepError("bad_first_sync", first)
    if not remote.endswith(":"):
        raise StepError("bad_name", remote)
    chk = step_check_local(local)
    if not chk["ok"]:
        raise StepError("local_" + chk["reason"], chk["path"])
    if mode != "twoway":
        return chk["path"], "none"
    if first == "none" or (first == "empty" and not chk["empty"]) or (first == "resume" and not chk["ours"]):
        raise StepError("needs_choice", "this folder already has files")
    return chk["path"], first


def step_apply(remote, remote_path, local, mode, first):
    local, first = validate_apply(remote, remote_path, local, mode, first)
    prev = load_setup() or {}
    created = bool(prev.get("step") == "connect" and prev.get("state") == "done"
                   and prev.get("remote") == remote and prev.get("createdRemote"))
    current = gc.effective()
    if current and current["remote"] == remote and current["createdRemote"]:
        created = True
    target = {"remote": remote, "remotePath": remote_path.strip("/"), "local": local, "mode": mode,
              "firstSync": first, "createdRemote": created}
    save_setup({"step": "apply", "state": "running", "unit": "gdrive-setup-apply.service",
                "startedAt": now_iso(), "target": target, "error": None})
    start_detached("apply", [remote, remote_path.strip("/"), local, mode, first])
    return {"started": True}


def run_sync(bin_dir, target, local, mode, resync):
    env = dict(os.environ, GDRIVE_REMOTE=target, GDRIVE_LOCAL=local, GDRIVE_MODE=mode,
               GDRIVE_STATS="10s")
    args = ["bash", os.path.join(bin_dir, "gdrive-sync")] + (["--resync"] if resync else [])
    return subprocess.run(args, env=env, capture_output=True, text=True).returncode


def read_status(p):
    try:
        with open(os.path.join(p["state"], "status.json"), encoding="utf-8") as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def step_apply_run(remote, remote_path, local, mode, first):
    """First sync, then (only after it succeeded) scripts, unit, config and service.
    Any failure leaves the previous setup as it was and running."""
    p = gc.paths()
    setup = load_setup() or {}
    created = bool((setup.get("target") or {}).get("createdRemote"))
    target = target_of(remote, remote_path)
    service = os.path.basename(p["unit"])
    was_active = systemctl("is-active", "--quiet", service).returncode == 0
    stopped = False
    try:
        if rclone(["lsd", target, "--max-depth", "1"], timeout=120).returncode != 0:
            raise StepError("offline", "Google Drive could not be reached")
        try:
            os.makedirs(local, exist_ok=True)
        except OSError as e:
            raise StepError("local_create", f"{local}: {e.strerror}")
        if was_active:
            systemctl("stop", service)  # "Change setup": the old pair must not run meanwhile
            stopped = True
        if mode == "twoway" and first == "match":
            aside = os.path.join(p["share"], "set-aside-" + datetime.date.today().isoformat())
            args = ["sync", target, local, "--backup-dir", aside, "--drive-export-formats", "desktop",
                    "--create-empty-src-dirs", "--log-file", os.path.join(p["state"], "sync.log"),
                    "--log-level", "INFO"]
            if os.path.exists(p["filters"]):
                args += ["--filter-from", p["filters"]]
            if rclone(args, timeout=None).returncode != 0:
                raise StepError("sync", "making the folder match Drive failed")
            update_setup(setAside=aside)
        before = (read_status(p).get("lastRunAt"), read_status(p).get("logOffset"))
        # the first sync runs the scripts next to this file; nothing is installed yet
        if run_sync(HERE, target, local, mode, resync=(mode == "twoway")) != 0:
            raise StepError("sync", "the first sync failed; see the log")
        st = read_status(p)
        if st.get("state") != "synced" or (st.get("lastRunAt"), st.get("logOffset")) == before:
            raise StepError("sync", f"the first sync did not finish ({st.get('state')})")
        install_service(dev=os.environ.get("GDRIVE_DEV") == "1")
        values = {"REMOTE": remote, "REMOTE_PATH": remote_path.strip("/"), "LOCAL": local, "MODE": mode}
        if created:
            values["CREATED_REMOTE"] = "1"
        gc.write_config(p["config"], values)
        r = systemctl("enable", "--now", service)
        if r.returncode != 0:
            raise StepError("systemd", (r.stderr or "").strip() or "the service did not start")
        if stopped:
            systemctl("restart", service)  # picks up the new unit and config
    except Exception as e:  # noqa: BLE001 - whatever happened, the old setup must come back
        if stopped:
            systemctl("start", service)
        if isinstance(e, StepError):
            fail_setup(e.code, e.message)
        else:
            fail_setup("unexpected", f"{type(e).__name__}: {e}")
        return 1
    update_setup(state="done", finishedAt=now_iso(), error=None)
    return 0


def step_cancel():
    setup = load_setup()
    if not setup or setup.get("state") != "running":
        return {"ok": True, "cancelled": False}
    systemctl("stop", setup.get("unit") or f"gdrive-setup-{setup.get('step')}.service")
    if setup.get("step") == "connect" and setup.get("remote"):
        # an interrupted login leaves a half-made connection (the name was free before)
        rclone(["config", "delete", setup["remote"].rstrip(":")], timeout=30)
    update_setup(state="cancelled", finishedAt=now_iso())
    return {"ok": True, "cancelled": True}


def step_disconnect(delete_remote=False):
    p = gc.paths()
    current = gc.effective()
    service = os.path.basename(p["unit"])
    systemctl("disable", "--now", service)
    backup = None
    if os.path.exists(p["config"]):
        backup = f"{p['config']}.bak-{datetime.datetime.now():%Y-%m-%d-%H%M%S}"
        os.replace(p["config"], backup)
    # without these a 0.1.0-style install would be "migrated" again
    for f in (os.path.join(p["state"], "initialized"), p["unit"]):
        if os.path.exists(f):
            os.unlink(f)
    systemctl("daemon-reload")
    deleted = False
    if delete_remote and current and current["createdRemote"]:
        deleted = rclone(["config", "delete", current["remote"].rstrip(":")], timeout=30).returncode == 0
    return {"ok": True, "configBackup": backup, "remoteDeleted": deleted}


# ---------- service install ----------

def unit_text(exec_path):
    if "\n" in exec_path or "\r" in exec_path:
        raise StepError("bad_path", "the script folder path contains a line break")
    # systemd interprets % and $ even inside quotes
    escaped = (exec_path.replace("\\", "\\\\").replace('"', '\\"')
               .replace("%", "%%").replace("$", "$$"))
    return f"""[Unit]
Description=Google Drive sync (gdrive-sync, rclone)
After=network-online.target

[Service]
Type=simple
ExecStart="{escaped}"
Restart=always
RestartSec=30
Nice=10
IOSchedulingClass=idle
TimeoutStopSec=120

[Install]
WantedBy=default.target
"""


def install_service(dev=False, start=False):
    p = gc.paths()
    if dev:
        bin_dir = HERE
    else:
        bin_dir = p["bin"]
        os.makedirs(bin_dir, exist_ok=True)
        if os.path.realpath(bin_dir) != os.path.realpath(HERE):
            for name in SCRIPTS:
                src = os.path.join(HERE, name)
                if os.path.exists(src):
                    tmp = os.path.join(bin_dir, f".{name}.tmp")
                    shutil.copyfile(src, tmp)
                    os.replace(tmp, os.path.join(bin_dir, name))
    for name in EXECUTABLE:
        f = os.path.join(bin_dir, name)
        if os.path.exists(f):
            os.chmod(f, 0o755)

    skipped = []
    os.makedirs(p["localBin"], exist_ok=True)
    for cmd in COMMANDS:
        link = os.path.join(p["localBin"], cmd)
        target = os.path.join(bin_dir, cmd)
        if not os.path.exists(target):
            continue
        if os.path.lexists(link) and not os.path.islink(link):
            skipped.append(link)  # the user's own file: never overwritten
            continue
        tmp = link + ".tmp-gdrive"
        if os.path.lexists(tmp):
            os.unlink(tmp)
        os.symlink(target, tmp)
        os.replace(tmp, link)

    text = unit_text(os.path.join(bin_dir, "gdrive-syncd"))
    try:
        with open(p["unit"], encoding="utf-8") as f:
            old = f.read()
    except OSError:
        old = None
    changed = old != text
    if changed:
        if old is not None:
            shutil.copyfile(p["unit"], p["unit"] + ".bak")
        gc.atomic_write(p["unit"], text)
    systemctl("daemon-reload")
    # keeps the service running across logouts and starts it at boot; best effort, no sudo
    try:
        subprocess.run(["loginctl", "enable-linger"], capture_output=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        pass
    if start:
        service = os.path.basename(p["unit"])
        if changed and systemctl("is-active", "--quiet", service).returncode == 0:
            systemctl("restart", service)
        r = systemctl("enable", "--now", service)
        if r.returncode != 0:
            raise StepError("systemd", (r.stderr or "").strip() or "the service did not start")
    return {"ok": True, "binDir": bin_dir, "unit": p["unit"], "changed": changed,
            "skippedLinks": skipped}


