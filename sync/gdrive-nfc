#!/usr/bin/env python3
"""Drive ve ~/GoogleDrive'daki NFD (ayristirilmis Unicode) adlari NFC'ye cevirir.

Neden: rclone bisync normal akista adlari normallestirerek karsilastirir, ama
--recover sirasinda yedek listeleri BAYT BAYT dogrular. Bir tarafta NFD, digerinde
NFC ad varsa kesinti sonrasi "path1 and path2 are out of sync" hatasi verir.
(2026-11-06 olayi; Mac'ten yuklenen dosyalar NFD gelir.)

Kullanim:  gdrive-nfc            -> sadece plan
           gdrive-nfc --uygula   -> uygula (servis DURDURULMUS olmali)
Sonrasinda: iki tarafi bayt duzeyinde karsilastir, sonra gdrive-sync --resync.
"""
import configparser, json, os, subprocess, sys, unicodedata, urllib.request

LOCAL = os.path.expanduser("~/GoogleDrive")
CONF = os.path.expanduser("~/.config/rclone/rclone.conf")
FILTERS = os.path.expanduser("~/.config/gdrive-sync/filters.txt")
SKIP_DIRS = {".venv", "__pycache__", "node_modules"}
APPLY = "--uygula" in sys.argv
NFC = lambda s: unicodedata.normalize("NFC", s)


def token():
    subprocess.run(["rclone", "lsd", "gdrive:", "--max-depth", "1"], capture_output=True)  # gerekirse yeniler
    c = configparser.ConfigParser(interpolation=None)
    c.read(CONF)
    return json.loads(c["gdrive"]["token"])["access_token"]


def drive_rename(fid, name, tok):
    req = urllib.request.Request(f"https://www.googleapis.com/drive/v3/files/{fid}?fields=id",
                                 method="PATCH", data=json.dumps({"name": name}).encode(),
                                 headers={"Authorization": "Bearer " + tok, "Content-Type": "application/json"})
    urllib.request.urlopen(req).read()


def main():
    errors = 0
    # ---- Drive ----
    out = subprocess.run(["rclone", "lsjson", "-R", "--fast-list", "--drive-skip-gdocs",
                          "--filter-from", FILTERS, "gdrive:"], capture_output=True, text=True, check=True)
    items = json.loads(out.stdout)
    seen = {}
    for o in items:
        seen.setdefault(NFC(o["Path"]), []).append(o)
    clash = [p for p, v in seen.items() if len(v) > 1]
    if clash:
        print("DRIVE CAKISMA (once elle coz):", *clash[:20], sep="\n  ")
        return 2
    todo = [o for o in items if o["Name"] != NFC(o["Name"])]
    print(f"Drive: {len(items)} nesne, {len(todo)} NFD ad")
    tok = token() if APPLY and todo else None
    for o in todo:
        print(("UYGULA " if APPLY else "PLAN   ") + f"drive  {o['ID']}  {NFC(o['Path'])}")
        if APPLY:
            try:
                drive_rename(o["ID"], NFC(o["Name"]), tok)
            except Exception as e:
                errors += 1; print("  HATA:", e)

    # ---- Yerel (asagidan yukari, ust klasor adi degisince alt yollar bozulmasin) ----
    n = 0
    for dp, dn, fn in os.walk(LOCAL, topdown=False):
        rel = os.path.relpath(dp, LOCAL)
        if any(part in SKIP_DIRS for part in rel.split(os.sep)):
            continue
        for x in dn + fn:
            if x == NFC(x):
                continue
            n += 1
            src, dst = os.path.join(dp, x), os.path.join(dp, NFC(x))
            if os.path.lexists(dst):
                errors += 1; print("YEREL CAKISMA (atlandi):", dst); continue
            print(("UYGULA " if APPLY else "PLAN   ") + "yerel  " + NFC(os.path.relpath(src, LOCAL)))
            if APPLY:
                os.rename(src, dst)
    print(f"Yerel: {n} NFD ad; hata/cakisma: {errors}")
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main())
