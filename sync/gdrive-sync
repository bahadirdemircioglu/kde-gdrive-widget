#!/usr/bin/env bash
# Google Drive senkronu: iki yonlu (rclone bisync), sadece yukleme ya da sadece indirme (rclone copy)
set -uo pipefail

. "$(dirname "$(readlink -f "$0")")/gdrive-lib.sh"   # REMOTE, LOCAL, MODE, CONF_DIR
STATE="${GDRIVE_STATE:-$HOME/.local/state/gdrive-sync}"
LOG="$STATE/sync.log"
LOCK="$STATE/lock"
FAILS="$STATE/ardisik_hata"
FILTERS="$CONF_DIR/filters.txt"   # degisirse bir kez --resync gerekir

mkdir -p "$LOCAL" "$STATE" "$(dirname "$FILTERS")"
[ -f "$FILTERS" ] || printf '%s\n' '# gdrive-sync haric tutma kurallari (yeniden uretilebilir icerik)' \
  '- .venv/**' '- __pycache__/**' '- node_modules/**' '- *.pyc' '- .~lock.*#' >"$FILTERS"

# Log sinirsiz buyumesin (>20MB ise bir onceki log'a dondur)
if [ -f "$LOG" ] && [ "$(stat -c %s "$LOG")" -gt 20000000 ]; then mv -f "$LOG" "$LOG.1"; fi

# Durum dosyasi (Plasma widget'i okur). Yardimci hata verse bile senkron etkilenmez.
STATUS_BIN="$(dirname "$(readlink -f "$0")")/gdrive-status"
status() {
  # python3 ile cagrilir: widget paketinden calisirken calistirma izni kaybolmus olabilir
  [ -f "$STATUS_BIN" ] && GDRIVE_LOCAL="$LOCAL" GDRIVE_REMOTE="$REMOTE" GDRIVE_MODE="$MODE" \
    python3 "$STATUS_BIN" "$@" >/dev/null 2>&1
  return 0
}

# Ardisik hatalari say; 3. hatada ve sonra saatte bir masaustu bildirimi gonder.
# (17 Ekim 2026'da kalan bir kilit yuzunden senkron 19 gun sessizce durmustu.)
fail() {
  local n=$(( $(cat "$FAILS" 2>/dev/null || echo 0) + 1 ))
  echo "$n" >"$FAILS"
  echo "$(date '+%F %T') $1 (ardisik hata: $n)" >>"$LOG"
  status end fail
  if [ "$n" -eq 3 ] || { [ "$n" -gt 3 ] && [ $(( n % 12 )) -eq 0 ]; }; then
    command -v notify-send >/dev/null && notify-send -u critical -a gdrive-sync \
      "Google Drive senkronu calismiyor" "$1 — $n kez ust uste. Ayrinti: $LOG" 2>/dev/null
  fi
  exit 1
}

# "gdrive-sync --resync": temel durumu sifirdan kurar.
# DIKKAT: resync iki tarafi BIRLESTIRIR; taraflar farkli duzenlenmisse dosyalar
# hem eski hem yeni yerde kalir. Sadece iki taraf ayniyken (ya da filtre degisince) kullan.
# Temel durum (initialized) yoksa senkron KENDILIGINDEN --resync yapmaz: ilk senkronu
# gdrive-setup yapar (bos klasor / onizleme kurallariyla). Elle "--resync" yazmak gerekir.
RESYNC=0
[ "${1:-}" = "--resync" ] && RESYNC=1

# Ayni anda iki senkron calismasin
exec 9>"$LOCK"
flock -n 9 || { echo "$(date '+%F %T') Onceki senkron hala calisiyor, atlandi." >>"$LOG"; exit 0; }

# Internet / uzak erisim yoksa bosuna ugrasma
if ! rclone lsd "$REMOTE" --max-depth 1 >/dev/null 2>&1; then
  echo "$(date '+%F %T') Drive'a ulasilamadi (internet yok?), atlandi." >>"$LOG"
  status begin; status end offline
  exit 0
fi

# Senkronun degistirdigi ya da sildigi her yerel dosya buraya tasinir (gunluk klasor, 30 gun).
BACKUP_ROOT="${GDRIVE_BACKUP:-$HOME/.local/share/gdrive-sync/backup}"
BACKUP="$BACKUP_ROOT/$(date +%F)"

COMMON=(
  --filters-file "$FILTERS"   # .venv, __pycache__ vb. senkronlanmaz
  --transfers 8 --checkers 16
  --log-file "$LOG" --log-level INFO
)
[ -n "${GDRIVE_STATS:-}" ] && COMMON+=(--stats "$GDRIVE_STATS")   # ilk senkronda sik ilerleme
BISYNC=(
  --create-empty-src-dirs
  --drive-export-formats desktop  # Google Dokumanlar tarayicida acilan .desktop kisayolu olur
  --conflict-resolve newer    # Cakismada yeni olan kazanir
  --conflict-loser delete     # Kaybeden klasorde kalmaz: yerelde $BACKUP'a, Drive'da cope gider
  --backup-dir1 "$BACKUP"
  --max-delete 25             # Tek seferde %25'ten fazla silme olursa dur (guvenlik)
  --resilient                 # Gecici hatalarda kendini toparlar
  --recover
  --max-lock 5m               # Yarida kalan calismanin kilidi 5 dk sonra gecersiz olur
  "${COMMON[@]}"
)

status begin
case "$MODE" in
  upload)
    # Sadece yukleme: Drive'da hicbir sey silinmez; ustune yazilan surum Drive surum gecmisinde kalir.
    echo "$(date '+%F %T') === senkron (sadece yukleme) ===" >>"$LOG"
    rclone copy "$LOCAL" "$REMOTE" --drive-skip-gdocs "${COMMON[@]}" || fail "Yukleme hatasi"
    ;;
  download)
    # Sadece indirme: yerelde hicbir sey silinmez; ustune yazilan yerel dosya $BACKUP'a gider.
    echo "$(date '+%F %T') === senkron (sadece indirme) ===" >>"$LOG"
    rclone copy "$REMOTE" "$LOCAL" --drive-export-formats desktop --backup-dir "$BACKUP" \
      "${COMMON[@]}" || fail "Indirme hatasi"
    ;;
  *)
    if [ "$RESYNC" = 1 ]; then
      echo "$(date '+%F %T') === ELLE ISTENEN --resync ===" >>"$LOG"
      # farkli dosyada yeni olan kazanir, eskisi yedege gider (varsayilan: yerel kazanir)
      if rclone bisync "$LOCAL" "$REMOTE" --resync --resync-mode newer "${BISYNC[@]}"; then
        touch "$STATE/initialized"
      else
        fail "--resync BASARISIZ"
      fi
    elif [ ! -f "$STATE/initialized" ]; then
      echo "$(date '+%F %T') ERROR : bisync baseline not initialized; run gdrive-setup" >>"$LOG"
      fail "Senkron kurulumu tamamlanmamis (temel durum yok). gdrive-setup calistirin"
    else
      echo "$(date '+%F %T') === senkron ===" >>"$LOG"
      rclone bisync "$LOCAL" "$REMOTE" "${BISYNC[@]}" || \
        fail "Senkron hatasi. --resync calistirmadan once log'u incele (iki tarafi birlestirir)"
    fi
    ;;
esac
rm -f "$FAILS"
status end ok
# 30 gunden eski yedek klasorlerini temizle
[ -d "$BACKUP_ROOT" ] && find "$BACKUP_ROOT" -mindepth 1 -maxdepth 1 -type d -mtime +30 \
  -exec rm -rf -- {} + 2>/dev/null
echo "$(date '+%F %T') tamam." >>"$LOG"
